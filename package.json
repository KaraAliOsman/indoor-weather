{
  "name": "indoor-weather",
  "version": "0.1.0",
  "private": true,
  "description": "A hands-only mixed reality almanac box that changes the weather of your real room. Built with Meta's Immersive Web SDK.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 47191 --strictPort",
    "build": "vite build && node tools/check-dist.mjs",
    "preview": "vite preview --host localhost --port 47173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.19.2",
    "@types/three": "0.181.0",
    "iwer": "2.5.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "overrides": {
    "three": "npm:super-three@0.181.0",
    "sharp": "0.35.4",
    "iwer": "2.5.0",
    "@iwer/devui": "2.5.0"
  }
}
